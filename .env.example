# Voice Agent Benchmark — environment template.
# Copy to .env and fill in. NEVER commit .env. NEVER paste real keys here.

# ============================================================
# LLM — OPENROUTER
# ============================================================
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# ============================================================
# LANGSMITH — OBSERVABILITY / TRACING
# ============================================================
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=voice-agent-benchmark
# Privacy: false = transcripts sent as sha256 prefixes, never raw text
LANGSMITH_SEND_TRANSCRIPTS=false

# ============================================================
# STT — DEEPGRAM
# ============================================================
DEEPGRAM_API_KEY=
# Optional second Deepgram account: free-tier concurrency/quota is per-account,
# so adapters rotate keys round-robin (account label is observable in events;
# the key itself never leaves the server).
DEEPGRAM2_API_KEY=
# Local whisper fallback (optional; offline mock is used in MOCK_MODE instead)
WHISPER_MODEL=base

# ============================================================
# STT — GOOGLE CLOUD (optional adapter slot, not required)
# ============================================================
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# ============================================================
# TTS — ELEVENLABS (also enables ElevenLabs Scribe STT)
# ============================================================
ELEVENLABS_API_KEY=
# Optional second ElevenLabs account (rotation; spreads free-tier quota)
ELEVENLABS2_API_KEY=
ELEVENLABS_MODEL=eleven_turbo_v2_5
ELEVENLABS_VOICE_ID=

# ============================================================
# TTS — OPENAI (alternative TTS; also enables OpenAI STT/LLM adapters)
# ============================================================
OPENAI_API_KEY=

# ============================================================
# APPLICATION
# ============================================================
ENVIRONMENT=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=

# ============================================================
# FRONTEND (build-time, NOT secrets — safe to expose)
# ============================================================
VITE_API_BASE_URL=
VITE_WS_URL=

# ============================================================
# DATABASE (empty = sqlite at data/vabd.db)
# ============================================================
DATABASE_URL=

# ============================================================
# APPLICATION SECURITY
# Generate locally, then paste the VALUE (not the command):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ============================================================
SECRET_KEY=

# ============================================================
# BEHAVIOR
# ============================================================
# MOCK_MODE=true runs deterministic offline providers (tests/CI only).
# Real benchmark runs must use MOCK_MODE=false with real keys configured.
MOCK_MODE=false
MAX_UPLOAD_MB=25
MAX_CONCURRENCY=10
CONCURRENCY_STAGGER_MS=250

# Cost guard for the experiment matrix runner (pipelines x tests x runs must
# not exceed this; the runner refuses to start beyond it)
MAX_EXPERIMENT_RUNS=100

# Optional extra tool providers
TAVILY_API_KEY=
CARTESIA_API_KEY=
